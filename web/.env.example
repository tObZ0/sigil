# local | mainnet
NEXT_PUBLIC_RELAY_NETWORK=mainnet
# RelayLaunchpad address and its deploy block (from contracts/deployments/<network>.json)
NEXT_PUBLIC_RELAY_ADDRESS=
NEXT_PUBLIC_RELAY_FROM_BLOCK=
# Public URL of the site (for link previews) and optional links shown in the footer
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# on: show ZEC bids (needs the relayer below). Anything else hides them.
NEXT_PUBLIC_ZEC=

# ── ZEC relayer: bid with shielded Zcash, served over Tor ─
# Leave DATABASE_URL empty to switch ZEC bidding off entirely.
DATABASE_URL=
# live: relay-scanner with your viewing key. dev: fake addresses + `npm run dev:pay`.
ZCASH_MODE=live
ZCASH_NETWORK=main
# Unified full viewing key (uview1…) of the wallet that receives ZEC. View-only:
# it can't spend. The seed stays with you, off the server.
RELAY_UFVK=
# Block height to start scanning from on a fresh database (around when the key was made).
SCAN_BIRTHDAY=
CONFIRMATIONS=3
# Relay's float on Robinhood Chain: funds every ZEC bid. Keep only a working amount on it.
HOT_WALLET_KEY=
HOT_WALLET_RESERVE_ETH=0.002
# 32 random bytes (0x…). Derives each order's bidding wallet. Back it up: an order
# mid-launch can only be finished with it.
ORDER_KEY_SEED=
BIDDER_GAS_ETH=0.0006
GAS_DRIP_ETH=0.0003
ZEC_FEE_BPS=100
MIN_BID_ETH=0.002
MAX_BID_ETH=2
MAX_ZEC=100
QUOTE_MINUTES=30
SEAL_MARGIN_MINUTES=10
RETENTION_DAYS=3
# From `npm run onion:keygen`. Shown in the footer so visitors can check the address.
NEXT_PUBLIC_ONION_ADDRESS=

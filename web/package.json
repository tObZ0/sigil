{
  "name": "relay-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "icon": "tsx scripts/make-icon.tsx",
    "worker": "tsx --env-file=.env.local src/server/worker.ts",
    "dev:pay": "tsx --env-file=.env.local scripts/dev-pay.ts",
    "onion:keygen": "tsx scripts/onion-keygen.ts",
    "build:worker": "esbuild src/server/worker.ts --bundle --platform=node --target=node22 --format=esm --packages=external --tsconfig=tsconfig.json --outfile=dist/worker.mjs --log-level=warning",
    "deploy:export": "node scripts/export-deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.37.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
